                                                              "uid":  "${ds_dw}"
                                                          },
                                           "rawQuery":  true,
                                           "rawSql":  "SELECT p.Pack, p.Required AS \"Required MP\",\n       CASE WHEN m.ManagementPackSystemName IS NULL THEN \u0027MISSING\u0027 ELSE \u0027Present\u0027 END AS Status\nFROM (VALUES\n  (\u0027Windows Server\u0027,\u0027Microsoft.Windows.Server.Library\u0027),\n  (\u0027Windows Server\u0027,\u0027Microsoft.Windows.Server.2016.Monitoring\u0027),\n  (\u0027Active Directory\u0027,\u0027Microsoft.Windows.Server.AD.Class.Library\u0027),\n  (\u0027Active Directory\u0027,\u0027Microsoft.Windows.Server.AD.2016.Monitoring\u0027),\n  (\u0027SQL Server\u0027,\u0027Microsoft.SQLServer.Core.Library\u0027),\n  (\u0027SQL Server\u0027,\u0027Microsoft.SQLServer.Windows.Monitoring\u0027)\n) p(Pack, Required)\nLEFT JOIN dbo.vManagementPack m ON m.ManagementPackSystemName = p.Required\nORDER BY p.Pack, p.Required",
                                           "format":  "table"
                                       }
                                   ],
