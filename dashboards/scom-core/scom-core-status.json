                                           "datasource":  {
                                                              "type":  "mssql",
                                                              "uid":  "${ds_dw}"
                                                          },
                                           "rawQuery":  true,
                                           "rawSql":  "SELECT g.ManagementGroupDefaultName AS \"Management group\",\n       (SELECT COUNT(*) FROM dbo.vManagementPack) AS \"Management packs\",\n       (SELECT COUNT(*) FROM dbo.vManagedEntity) AS \"Managed entities\",\n       (SELECT MAX(DateTime) FROM Perf.vPerfRaw) AS \"Latest perf sample (UTC)\",\n       (SELECT MAX(DateTime) FROM State.vStateRaw) AS \"Latest state change (UTC)\"\nFROM dbo.vManagementGroup g WHERE g.OwnerManagementGroupInd = 1",
                                           "format":  "table"
                                       }
                                   ],
                       "title":  "Management group and latest data",
