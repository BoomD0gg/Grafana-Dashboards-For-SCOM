                       "id":  1,
                       "type":  "table",
                       "description":  "Detected from the OperationsManager database version. Unrecognised versions fall back to the latest adapter.",
                       "datasource":  {
                                          "type":  "mssql",
                                          "uid":  "${ds_om}"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "custom":  {
                                                                           "align":  "auto",
                                                                           "cellOptions":  {
                                                                                               "type":  "auto"
                                                                                           },
                                                                           "filterable":  true
                                                                       },
                                                            "links":  [

                                                                      ],
                                                            "noValue":  "No data"
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "editorMode":  "code",
                                           "refId":  "A",
                                           "datasource":  {
                                                              "type":  "mssql",
                                                              "uid":  "${ds_om}"
                                                          },
                                           "rawQuery":  true,
                                           "rawSql":  "SELECT ManagementGroupName AS \"Management group\",\n       DBVersion AS \"Database version\",\n       CASE WHEN DBVersion LIKE \u002710.19.%\u0027 THEN \u0027SCOM 2019\u0027\n            WHEN DBVersion LIKE \u002710.22.%\u0027 THEN \u0027SCOM 2022\u0027\n            WHEN DBVersion LIKE \u002710.25.%\u0027 THEN \u0027SCOM 2025\u0027\n            ELSE \u0027Unrecognised - latest adapter assumed\u0027 END AS \"Detected product\",\n       CASE WHEN DBVersion LIKE \u002710.19.%\u0027 OR DBVersion LIKE \u002710.22.%\u0027 OR DBVersion LIKE \u002710.25.%\u0027\n            THEN \u0027adapter-\u0027 + SUBSTRING(DBVersion,1,5) ELSE \u0027adapter-default\u0027 END AS \"Adapter\"\nFROM dbo.__MOMManagementGroupInfo__",
                                           "format":  "table"
                                       }
                                   ],
                       "title":  "SCOM version detection (selects the data-layer adapter)",
                       "gridPos":  {
                                       "y":  0,
                                       "w":  24,
                                       "h":  4,
                                       "x":  0
