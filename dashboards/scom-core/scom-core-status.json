                       "targets":  [
                                       {
                                           "editorMode":  "code",
                                           "refId":  "A",
                                           "datasource":  {
                                                              "type":  "mssql",
                                                              "uid":  "${ds_dw}"
                                                          },
                                           "rawQuery":  true,
                                           "rawSql":  "SELECT e.DisplayName AS Computer,\n  (SELECT DATEDIFF(minute, MAX(p.DateTime), GETUTCDATE())\n     FROM dbo.vManagedEntity c\n     JOIN Perf.vPerfRaw p ON p.ManagedEntityRowId = c.ManagedEntityRowId\n     WHERE c.TopLevelHostManagedEntityRowId = e.ManagedEntityRowId AND p.DateTime \u003e DATEADD(day, -7, GETUTCDATE())) AS \"Minutes since last perf sample\",\n  (SELECT DATEDIFF(minute, MAX(s.DateTime), GETUTCDATE())\n     FROM dbo.vManagedEntity c\n     JOIN dbo.vManagedEntityMonitor em ON em.ManagedEntityRowId = c.ManagedEntityRowId\n     JOIN State.vStateRaw s ON s.ManagedEntityMonitorRowId = em.ManagedEntityMonitorRowId\n     WHERE (c.TopLevelHostManagedEntityRowId = e.ManagedEntityRowId OR c.ManagedEntityRowId = e.ManagedEntityRowId)\n       AND s.DateTime \u003e DATEADD(day, -7, GETUTCDATE())) AS \"Minutes since last state change\"\nFROM dbo.vManagedEntity e\nJOIN dbo.vManagedEntityType t ON t.ManagedEntityTypeRowId = e.ManagedEntityTypeRowId AND t.ManagedEntityTypeSystemName = \u0027Microsoft.Windows.Computer\u0027\nWHERE e.DisplayName IN (${server:singlequote})\nORDER BY 2 DESC",
                                           "format":  "table"
                                       }
                                   ],
