                                           "datasource":  {
                                                              "type":  "mssql",
                                                              "uid":  "${ds_om}"
                                                          },
                                           "rawQuery":  true,
                                           "rawSql":  "SELECT v.Property, v.Value\nFROM (SELECT TOP 1 a.* FROM (SELECT al.AlertId AS Id, al.AlertName AS Name, al.AlertDescription AS Description, al.BaseManagedEntityId AS MonitoringObjectId, bm.DisplayName AS MonitoringObjectDisplayName, bm.FullName AS MonitoringObjectFullName, bm.Path AS MonitoringObjectPath, bm.TopLevelHostEntityId AS TopLevelHostEntityId, al.IsMonitorAlert, al.RuleId AS MonitoringRuleId, al.ResolutionState, al.Priority, al.Severity, al.Category, al.Owner, al.ResolvedBy, al.TimeRaised, al.LastModified, al.TimeResolved, al.RepeatCount, al.TicketId, al.Context, al.AlertParams, al.CustomField1, al.CustomField2, al.CustomField3, (SELECT TOP 1 lt.LTValue FROM dbo.LocalizedText lt WHERE lt.LTStringId = al.AlertStringId AND lt.LTStringType = 1 ORDER BY CASE WHEN lt.LanguageCode = \u0027ENU\u0027 THEN 0 ELSE 1 END, lt.LanguageCode) AS AlertStringName, (SELECT TOP 1 lt.LTValue FROM dbo.LocalizedText lt WHERE lt.LTStringId = al.AlertStringId AND lt.LTStringType = 2 ORDER BY CASE WHEN lt.LanguageCode = \u0027ENU\u0027 THEN 0 ELSE 1 END, lt.LanguageCode) AS AlertStringDescription FROM dbo.Alert al JOIN dbo.BaseManagedEntity bm ON bm.BaseManagedEntityId = al.BaseManagedEntityId) a WHERE a.Id = TRY_CAST(${alertid:singlequote} AS uniqueidentifier)) a\nCROSS APPLY (VALUES\n  (1,  \u0027Alert\u0027,          CAST(COALESCE(NULLIF(a.AlertStringName, \u0027\u0027), a.Name) AS nvarchar(4000))),\n  (2,  \u0027Severity\u0027,       CAST(CASE a.Severity WHEN 2 THEN \u0027Critical\u0027 WHEN 1 THEN \u0027Warning\u0027 ELSE \u0027Information\u0027 END AS nvarchar(4000))),\n  (3,  \u0027Priority\u0027,       CAST(CASE a.Priority WHEN 2 THEN \u0027High\u0027 WHEN 1 THEN \u0027Medium\u0027 ELSE \u0027Low\u0027 END AS nvarchar(4000))),\n  (4,  \u0027Status\u0027,         CAST((SELECT TOP 1 rs.ResolutionStateName FROM dbo.ResolutionState rs WHERE rs.ResolutionState = a.ResolutionState) AS nvarchar(4000))),\n  (5,  \u0027Source\u0027,         CAST(a.MonitoringObjectDisplayName AS nvarchar(4000))),\n  (6,  \u0027Path\u0027,           CAST(a.MonitoringObjectPath AS nvarchar(4000))),\n  (7,  \u0027Computer\u0027,       CAST((SELECT TOP 1 c.DisplayName FROM dbo.ManagedEntityGenericView c WHERE c.Id = a.TopLevelHostEntityId) AS nvarchar(4000))),\n  (8,  \u0027Raised (UTC)\u0027,   CONVERT(nvarchar(30), a.TimeRaised, 120)),\n  (9,  \u0027Last modified (UTC)\u0027, CONVERT(nvarchar(30), a.LastModified, 120)),\n  (10, \u0027Resolved (UTC)\u0027, CONVERT(nvarchar(30), a.TimeResolved, 120)),\n  (11, \u0027Repeat count\u0027,   CAST(a.RepeatCount AS nvarchar(20))),\n  (12, \u0027Owner\u0027,          CAST(a.Owner AS nvarchar(4000))),\n  (13, \u0027Resolved by\u0027,    CAST(a.ResolvedBy AS nvarchar(4000))),\n  (14, \u0027Ticket ID\u0027,      CAST(a.TicketId AS nvarchar(4000))),\n  (15, \u0027Category\u0027,       CAST(a.Category AS nvarchar(4000))),\n  (16, \u0027Raised by\u0027,      CAST(CASE WHEN a.IsMonitorAlert = 1 THEN \u0027Monitor\u0027 ELSE \u0027Rule\u0027 END AS nvarchar(4000))),\n  (17, \u0027Monitor or rule\u0027, CAST(a.Name AS nvarchar(4000))),\n  (18, \u0027Custom field 1\u0027, CAST(a.CustomField1 AS nvarchar(4000))),\n  (19, \u0027Custom field 2\u0027, CAST(a.CustomField2 AS nvarchar(4000))),\n  (20, \u0027Custom field 3\u0027, CAST(a.CustomField3 AS nvarchar(4000))),\n  (21, \u0027Alert ID\u0027,       CAST(a.Id AS nvarchar(40)))\n) v(ord, Property, Value)\nWHERE v.Value IS NOT NULL AND v.Value \u003c\u003e \u0027\u0027\nORDER BY v.ord",
                                           "format":  "table"
                                       }
                                   ],
