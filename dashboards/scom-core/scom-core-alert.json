                                           "rawQuery":  true,
                                           "rawSql":  "SELECT s.value(\u0027(*[local-name()=\"title\"])[1]\u0027, \u0027nvarchar(200)\u0027) AS Section,\n       s.query(\u0027*[local-name()!=\"title\"]\u0027).value(\u0027.\u0027, \u0027nvarchar(max)\u0027) AS Text\nFROM (SELECT TOP 1 TRY_CAST(k.Content AS xml) AS x\n      FROM dbo.KnowledgeView k\n      WHERE k.KnowledgeReferenceId = (SELECT TOP 1 a.MonitoringRuleId FROM (SELECT al.AlertId AS Id, al.AlertName AS Name, al.AlertDescription AS Description, al.BaseManagedEntityId AS MonitoringObjectId, bm.DisplayName AS MonitoringObjectDisplayName, bm.FullName AS MonitoringObjectFullName, bm.Path AS MonitoringObjectPath, bm.TopLevelHostEntityId AS TopLevelHostEntityId, al.IsMonitorAlert, al.RuleId AS MonitoringRuleId, al.ResolutionState, al.Priority, al.Severity, al.Category, al.Owner, al.ResolvedBy, al.TimeRaised, al.LastModified, al.TimeResolved, al.RepeatCount, al.TicketId, al.Context, al.AlertParams, al.CustomField1, al.CustomField2, al.CustomField3, (SELECT TOP 1 lt.LTValue FROM dbo.LocalizedText lt WHERE lt.LTStringId = al.AlertStringId AND lt.LTStringType = 1 ORDER BY CASE WHEN lt.LanguageCode = \u0027ENU\u0027 THEN 0 ELSE 1 END, lt.LanguageCode) AS AlertStringName, (SELECT TOP 1 lt.LTValue FROM dbo.LocalizedText lt WHERE lt.LTStringId = al.AlertStringId AND lt.LTStringType = 2 ORDER BY CASE WHEN lt.LanguageCode = \u0027ENU\u0027 THEN 0 ELSE 1 END, lt.LanguageCode) AS AlertStringDescription FROM dbo.Alert al JOIN dbo.BaseManagedEntity bm ON bm.BaseManagedEntityId = al.BaseManagedEntityId) a WHERE a.Id = TRY_CAST(${alertid:singlequote} AS uniqueidentifier)) AND k.Visible = 1\n      ORDER BY CASE WHEN k.LanguageCode = \u0027ENU\u0027 THEN 0 ELSE 1 END, k.LanguageCode) c\nCROSS APPLY c.x.nodes(\u0027//*[local-name()=\"section\"]\u0027) AS t(s)",
                                           "format":  "table"
                                       }
                                   ],
                       "title":  "Product knowledge",
                       "gridPos":  {
                                       "y":  20,
                                       "w":  12,
                                       "h":  9,
                                       "x":  12
                                   }
                   }
               ],
