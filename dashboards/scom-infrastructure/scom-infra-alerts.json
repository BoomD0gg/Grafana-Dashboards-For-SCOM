                                                          },
                                           "rawQuery":  true,
                                           "rawSql":  "SELECT TOP 20\n  a.AlertName AS Alert,\n  COUNT(*) AS Raised,\n  SUM(CASE WHEN a.Severity = 2 THEN 1 ELSE 0 END) AS Critical,\n  SUM(CASE WHEN a.Severity = 1 THEN 1 ELSE 0 END) AS Warning,\n  COUNT(DISTINCT a.ManagedEntityRowId) AS \"Distinct sources\",\n  SUM(a.RepeatCount) AS \"Total repeats\",\n  MAX(a.RaisedDateTime) AS \"Last raised (UTC)\"\nFROM Alert.vAlert a\nWHERE a.RaisedDateTime BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY a.AlertName\nORDER BY COUNT(*) DESC",
                                           "format":  "table"
                                       }
                                   ],
