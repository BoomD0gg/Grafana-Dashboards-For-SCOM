                       "targets":  [
                                       {
                                           "editorMode":  "code",
                                           "refId":  "A",
                                           "datasource":  {
                                                              "type":  "mssql",
                                                              "uid":  "${ds_dw}"
                                                          },
                                           "rawQuery":  true,
                                           "rawSql":  "SELECT time, metric, value FROM (\n  SELECT DATEADD(minute, (DATEDIFF(minute, 0, p.DateTime) / 5) * 5, 0) AS time,\n         CASE WHEN i.InstanceName = \u0027\u0027 THEN r.CounterName ELSE i.InstanceName END AS metric,\n         AVG(p.SampleValue) AS value\n  FROM Perf.vPerfRaw p\n  JOIN dbo.vPerformanceRuleInstance i ON i.PerformanceRuleInstanceRowId = p.PerformanceRuleInstanceRowId\n  JOIN dbo.vPerformanceRule r ON r.RuleRowId = i.RuleRowId\n  WHERE DATEDIFF(minute, $__timeFrom(), $__timeTo()) \u003c= 2880\n    AND p.DateTime BETWEEN $__timeFrom() AND $__timeTo()\n    AND r.ObjectName = \u0027ManagementGroupAlerts\u0027 AND r.CounterName = \u0027AlertsCount\u0027\n  GROUP BY DATEADD(minute, (DATEDIFF(minute, 0, p.DateTime) / 5) * 5, 0), CASE WHEN i.InstanceName = \u0027\u0027 THEN r.CounterName ELSE i.InstanceName END\n  UNION ALL\n  SELECT p.DateTime, CASE WHEN i.InstanceName = \u0027\u0027 THEN r.CounterName ELSE i.InstanceName END, AVG(p.AverageValue)\n  FROM Perf.vPerfHourly p\n  JOIN dbo.vPerformanceRuleInstance i ON i.PerformanceRuleInstanceRowId = p.PerformanceRuleInstanceRowId\n  JOIN dbo.vPerformanceRule r ON r.RuleRowId = i.RuleRowId\n  WHERE (DATEDIFF(minute, $__timeFrom(), $__timeTo()) \u003e 2880 OR NOT EXISTS (SELECT 1 FROM Perf.vPerfRaw x WHERE x.DateTime BETWEEN $__timeFrom() AND $__timeTo()))\n    AND p.DateTime BETWEEN $__timeFrom() AND $__timeTo()\n    AND r.ObjectName = \u0027ManagementGroupAlerts\u0027 AND r.CounterName = \u0027AlertsCount\u0027\n  GROUP BY p.DateTime, CASE WHEN i.InstanceName = \u0027\u0027 THEN r.CounterName ELSE i.InstanceName END\n) x ORDER BY time",
                                           "format":  "time_series"
                                       }
                                   ],
