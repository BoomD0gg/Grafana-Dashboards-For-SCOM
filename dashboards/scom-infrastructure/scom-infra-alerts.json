                                           "rawQuery":  true,
                                           "rawSql":  "SELECT\n  DATEADD(hour, DATEDIFF(hour, 0, a.RaisedDateTime), 0) AS time,\n  CASE a.Severity WHEN 2 THEN \u0027Critical\u0027 WHEN 1 THEN \u0027Warning\u0027 ELSE \u0027Information\u0027 END AS metric,\n  COUNT(*) AS value\nFROM Alert.vAlert a\nWHERE a.RaisedDateTime BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY DATEADD(hour, DATEDIFF(hour, 0, a.RaisedDateTime), 0), a.Severity\nORDER BY 1",
